{
  "info": {
    "name": "GIS API Testing",
    "schema": "https://getpostman.com"
  },
  "item": [
    {
      "name": "User Registration Valid",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "username", "value": "GisTester", "type": "text"},
            {"key": "email", "value": "testapi@gis.com", "type": "text"},
            {"key": "password", "value": "password123", "type": "text"}
          ]
        },
        "url": { "raw": "{{baseUrl}}/php/Reg.php" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP Status is 200 or 302', function () { pm.expect(pm.response.code).to.be.oneOf([200, 302]); });"
            ]
          }
        }
      ]
    }
  ]
}
